APP_NAME="MARKAZ_AL_AZIZ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# School identity dataset (used in receipt/document header)
APP_NAMA_INSTANSI="MARKAZ_AL_AZIZ"
APP_NAMA_SUB_INSTANSI_1=
APP_NAMA_SUB_INSTANSI_2=
APP_AKREDITASI=
APP_ALAMAT="Pekanbaru, Riau, Indonesia"
APP_TELEPON=
APP_EMAIL=
APP_WEBSITE=
APP_DOMISILI="Pekanbaru"

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pekanbaru_ittihad
DB_USERNAME=root
DB_PASSWORD=

# For local SQLite instead of MySQL:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
#
# Tests use `.env.testing` (sqlite :memory:) when present, otherwise phpunit.xml — never point tests at this DB.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# School / virtual account (6-digit prefix + 10-digit zero-padded NIS suffix → 16 digits)
VA_PREFIX=770000

# Finance online payment API (bank VA / JWT)
FINANCE_JWT_KEY=
FINANCE_JWT_ALGO=HS256
FINANCE_PAYMENT_MODE=auto_loop
BIAYA_ADMIN=0

# Admin fee for transfer saldo keuangan → saldo cashless
BIAYA_ADMIN_PINDAH_SALDO=1000

# Infaq (donation) on pindah saldo: off | on | optional (default: off)
INFAQ_MODE=off
INFAQ_MAX=10000

# Manual admin penyesuaian saldo keuangan (default: disabled)
MANUAL_SALDO_KEUANGAN_ADJUSTMENT_ENABLED=false

# Manual admin top-up / tarik saldo cashless (default: disabled)
MANUAL_SALDO_CASHLESS_ADJUSTMENT_ENABLED=false

# Minimum pelanggaran points to issue hukuman (default: 250)
HUKUMAN_MIN_POINTS=250

PROFILE_PHOTO_WEBP_QUALITY=88

# Portal magic-link login (WhatsApp invite from admin)
# How long the invite URL stays valid (days). Re-issue links after changing this.
PORTAL_ACCESS_TOKEN_TTL_DAYS=7
# Optional: idle session minutes after /access login (default = TTL days × 24 × 60)
# PORTAL_SESSION_LIFETIME=525600
PORTAL_APP_NAME="MARKAZ_AL_AZIZ"

# Portal PWA (installable app for portal roles)
# PWA_SHORT_NAME="MARKAZ_AL_AZIZ"
# PWA_DESCRIPTION="Portal sekolah MARKAZ_AL_AZIZ"
# PWA_CACHE_VERSION=1

# JWT (token signing for portal/API)
JWT_KEY=
JWT_ALGO=HS256
JWT_TTL=1440
JWT_REFRESH_TTL=10080
JWT_ISSUER="${APP_NAME}"

# Cloudflare Turnstile (login bot protection, disabled by default)
TURNSTILE=FALSE
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Database seeding (local: full demo data | production: schools + initial users)
SEED_MODE=full
# SEED_MODE=production
# SEED_SUPERADMIN_USERNAME=superadmin
# SEED_SUPERADMIN_NAME="Super Admin"
# SEED_SUPERADMIN_EMAIL=superadmin@example.com
# SEED_SUPERADMIN_PHONE=
# SEED_SUPERADMIN_PASSWORD=
# SEED_ADMIN_ENABLED=true
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_NAME=Administrator
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PHONE=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_SEKOLAH_CODE=ma
